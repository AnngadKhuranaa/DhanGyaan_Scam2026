    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.11",
    "morgan": "^1.10.0",
    "newsapi": "^2.4.1",
    "node-cache": "^5.1.2",
    "openai": "^7.64.0",
    "winston": "^3.13.0",
    "yahoo-finance2": "^4.0.6"
