# ── Required ─────────────────────────────────────────────────────────────
# MongoDB must be a replica set (paper trades use transactions).
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/dhangyaan
#   Local:  run `npm run dev:db`, then use the URI below
MONGO_URI=mongodb://127.0.0.1:27017/dhangyaan?replicaSet=rs0

# Two DIFFERENT long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS + cookies)
CLIENT_URL=http://localhost:5173

# ── Optional: tuning ─────────────────────────────────────────────────────
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7
# STARTING_BALANCE=1000000
# DEMO_USERNAME=demo
# LOG_LEVEL=debug

# ── Optional: AI explainer (Gemini primary, OpenAI fallback) ─────────────
# Without either key the explainer returns a labelled rule-based summary.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Optional: news sentiment (https://newsapi.org) ───────────────────────
# Without a key, sentiment shows clearly labelled demo headlines and is
# excluded from the confidence score.
NEWS_API_KEY=
